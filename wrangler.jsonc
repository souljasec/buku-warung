{
  // Your own warung book: the app (./web, built into ./dist) + a cloud copy of the book (Worker + KV), Cloudflare free plan.
  // Easiest: `node scripts/setup.mjs` fills in name and id below, deploys and prints your connect link.
  "name": "buku",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node scripts/build.mjs", "watch_dir": "web" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "BOOK", "id": "REPLACE_WITH_KV_ID" }]
}
